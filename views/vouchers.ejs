<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .voucher-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:16px; margin-top:20px; }
        .v-card { background:var(--card-bg); border:1px solid var(--border); border-radius:16px; padding:20px; text-align:center; position:relative; }
        .v-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,var(--primary),var(--secondary)); border-radius:16px 16px 0 0; }
        .v-profile { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; }
        .v-code { font-size:20px; font-weight:700; color:var(--primary); margin-bottom:8px; font-family:monospace; }
        .v-price { font-size:14px; font-weight:600; color:var(--success); }
        .overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:var(--overlay-bg); backdrop-filter:blur(4px); display:none; align-items:center; justify-content:center; z-index:9999; }
        .modal { background:var(--modal-bg); border:1px solid var(--border); border-radius:20px; width:100%; max-width:450px; padding:28px; }
        .modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}.modal-title{font-size:18px;font-weight:600;margin:0;}.close-btn{background:none;border:none;color:var(--muted);font-size:22px;cursor:pointer;}
        .form-group{margin-bottom:14px;}.form-group label{display:block;margin-bottom:6px;font-size:13px;color:var(--muted);}
        .toast{position:fixed;bottom:24px;right:24px;background:var(--toast-bg);color:var(--text);border:1px solid var(--border);border-radius:12px;padding:14px 20px;z-index:9999;display:none;font-size:14px;}.toast.show{display:block;}
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/topbar', { title: t.vouchers_title }) %>
    <div class="content">
        <!-- Navigation Tabs -->
        <div style="display: flex; gap: 10px; margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
            <a href="/hotspot" style="padding: 10px 20px; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 14px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--muted); display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;">
                <i class="fas fa-users"></i> Users & Profiles
            </a>
            <a href="/hotspot/vouchers" style="padding: 10px 20px; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 14px; background: var(--primary); color: white; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-ticket"></i> Vouchers
            </a>
        </div>

        <div class="page-header">
            <h1 class="page-title"><%= t.generate_vouchers %></h1>
            <div style="display:flex;gap:25px;align-items:center;margin-bottom:10px">
                <a href="/hotspot/print" target="_blank" class="btn btn-info">🖨 <%= t.print_all_last_50 %></a>
                <button class="btn btn-primary" onclick="openGenModal()">+ <%= t.generate_bulk_vouchers %></button>
            </div>
        </div>

        <div class="card">
            <h3 style="margin:0 0 20px;font-size:16px"><%= t.recent_vouchers %></h3>
            <div class="voucher-grid">
                <% if(vouchers.length > 0) { %>
                    <% vouchers.forEach(v => { %>
                    <div class="v-card">
                        <div class="v-profile"><%= v.profile %></div>
                        <div class="v-code"><%= v.code %></div>
                        <div class="v-price"><%= t.currency %> <%= parseFloat(v.price).toLocaleString(lang === 'id' ? 'id-ID' : 'en-US') %></div>
                        <div style="margin-top:10px;font-size:10px;color:var(--muted)"><%= v.created_at ? new Date(v.created_at).toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US') : '-' %></div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div style="grid-column:1/-1;color:var(--muted);padding:40px;text-align:center"><%= t.no_vouchers %></div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="overlay" id="genModal" onclick="if(event.target===this)closeGenModal()">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header"><h2 class="modal-title"><%= t.generate_bulk_vouchers %></h2><button class="close-btn" onclick="closeGenModal()">×</button></div>
        <form id="genForm">
            <div class="form-group"><label><%= t.voucher_count %></label><input type="number" id="vCount" class="form-control" value="10" required></div>
            <div class="form-group"><label><%= t.hotspot_profile %></label><input type="text" id="vProfile" class="form-control" value="default" required></div>
            <div class="form-group"><label><%= t.price %> (Rp)</label><input type="number" id="vPrice" class="form-control" value="5000"></div>
            
            <div class="form-group">
                <label>Karakter Voucher</label>
                <select id="vCharType" class="form-control" onchange="toggleCustomChars()">
                    <option value="alphanumeric">Huruf & Angka (A-Z, 0-9)</option>
                    <option value="numeric">Hanya Angka (0-9)</option>
                    <option value="alphabet">Hanya Huruf (A-Z)</option>
                    <option value="custom">Kustom...</option>
                </select>
            </div>
            
            <div class="form-group" id="customCharsGroup" style="display:none;">
                <label>Karakter Kustom</label>
                <input type="text" id="vCustomChars" class="form-control" placeholder="Contoh: ABCDE12345">
            </div>

            <div class="grid-2" style="gap:10px;">
                <div class="form-group"><label><%= t.code_length %></label><input type="number" id="vLength" class="form-control" value="6"></div>
                <div class="form-group"><label><%= t.prefix %></label><input type="text" id="vPrefix" class="form-control" placeholder="<%= t.example_prefix %>"></div>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:10px"><%= t.start_generate %></button>
        </form>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
function openGenModal(){document.getElementById('genModal').style.display='flex';}
function closeGenModal(){document.getElementById('genModal').style.display='none';}
function toggleCustomChars() {
    const val = document.getElementById('vCharType').value;
    document.getElementById('customCharsGroup').style.display = val === 'custom' ? 'block' : 'none';
}
function showToast(msg,type){const t=document.getElementById('toast');t.textContent=msg;t.style.borderColor=type==='success'?'rgba(16,185,129,.4)':'rgba(239,68,68,.4)';t.style.color=type==='success'?'#10B981':'#EF4444';t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3500);}

document.getElementById('genForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    let characters = '';
    const charType = document.getElementById('vCharType').value;
    if (charType === 'alphanumeric') {
        characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    } else if (charType === 'numeric') {
        characters = '0123456789';
    } else if (charType === 'alphabet') {
        characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    } else if (charType === 'custom') {
        characters = document.getElementById('vCustomChars').value || 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    }

    const body = {
        count: document.getElementById('vCount').value,
        profile: document.getElementById('vProfile').value,
        price: document.getElementById('vPrice').value,
        length: document.getElementById('vLength').value,
        prefix: document.getElementById('vPrefix').value,
        characters: characters
    };
    const res = await fetch('/hotspot/api/generate', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(body)
    });
    const d = await res.json();
    showToast(d.message, d.success ? 'success' : 'error');
    if(d.success){closeGenModal();setTimeout(()=>location.reload(),1000);}
});
</script>
</body>
</html>
